{
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD029": { "style": "ordered" }
  },
  "ignores": [
    "**/.git/**",
    "**/.venv/**",
    ".node_modules/**",
    "**/node_modules/**",
    "**/target/**",
    "vendor/wireframe/**",
    ".vtcode/**",
    ".terraform/**",
    ".uv-cache/**",
    "memories/**",
    "CRUSH.md",
    // Byte-for-byte upstream copies, validated by provenance checksums.
    "docs/rstest-bdd-users-guide.md",
    "docs/rstest-bdd-v0-6-0-migration-guide.md"
  ]
}
